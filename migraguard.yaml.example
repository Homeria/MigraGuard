# 🛡️ MigraGuard Configuration Example
# Copy this file to 'migraguard.yaml' and customize it for your environment.

# 1. Database Connections
database:
  # Target PostgreSQL connection string
  postgres: "postgres://user:pass@localhost:5432/target_db"
  # Local SQLite storage for historical metrics
  sqlite: "./migraguard.db"

# 2. Metric Collection Agent
agent:
  # Collection interval (e.g., 10s, 1m, 1h)
  interval: "1m"
  # How long to keep metrics data (days)
  retention_days: 7

# 3. Risk Engine Configuration
risk:
  # --- Infrastructure Performance Thresholds ---
  # Disk I/O performance in bytes per second (Default: 100MB/s)
  disk_io: 104857600
  # System maximum capacity in TPS (Default: 5000)
  mu_max: 5000.0
  # Database maximum connection limit (Default: 500)
  c_max: 500
  # Max allowed metadata change delay in ms (Default: 100ms)
  t_meta: 100.0
  # Query execution timeout in ms (Default: 5000ms)
  t_timeout: 5000.0

  # --- Decision Thresholds ---
  # Risk scores above these values will trigger warnings or block deployment.
  thresholds:
    danger: 80.0
    warning: 50.0

  # --- Algorithm Weights (Internal Magic Numbers) ---
  weights:
    # Conservative estimation multipliers for TPS
    avg_multiplier: 1.2    # (1h-Avg * 1.2)
    peak_multiplier: 0.8   # (24h-Peak * 0.8)

    # Lock impact factors (Multipliers for blocking time)
    concurrent_impact: 0.1 # Impact for CONCURRENTLY operations
    middle_impact: 0.5     # Impact for non-exclusive locks

    # Base risk scores for specific lock levels (Minimum scores)
    base_access_exclusive_meta: 30.0
    base_access_exclusive_full: 85.0
    base_exclusive: 50.0
    base_share: 20.0
