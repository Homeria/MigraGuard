direction: down

# ==========================================
# 0. 공통 스타일 정의
# ==========================================
classes: {
  layer_cli: { style: { fill: "#f9f5ff"; stroke: "#7c3aed"; stroke-width: 2; border-radius: 8 } }
  layer_app: { style: { fill: "#f0f9ff"; stroke: "#0284c7"; stroke-width: 2; border-radius: 8 } }
  layer_domain: { style: { fill: "#f0fdf4"; stroke: "#16a34a"; stroke-width: 2; border-radius: 8 } }
  layer_infra: { style: { fill: "#fffbeb"; stroke: "#d97706"; stroke-width: 2; border-radius: 8 } }
  layer_shared: { style: { fill: "#f8fafc"; stroke: "#64748b"; stroke-width: 1; border-radius: 8 } }
  module_box: { style: { fill: "#ffffff"; stroke: "#94a3b8"; stroke-width: 1; stroke-dash: 5; border-radius: 4 } }
  func_node: { style: { fill: "#ffffff"; stroke: "#cbd5e1"; stroke-width: 1; border-radius: 6; shadow: true } }
  type_node: { style: { fill: "#e0e7ff"; stroke: "#4338ca"; stroke-width: 1; border-radius: 6 } }
}

# ==========================================
# 1. CLI Layer
# ==========================================
CLI_Layer: 1. CLI Layer {
  class: layer_cli
  cmd_agent: agent.go {
    class: module_box
    CG_Run: {
      class: func_node
      label: |md
        **Run()**
        ---
        * **Args:** cmd, args
        * **Returns:** error
        * **Desc:** OS 신호 감지 및 에이전트 서비스 백그라운드 가동
      |
    }
  }
}

# ==========================================
# 2. App Layer
# ==========================================
APP_Layer: 2. Application Service Layer {
  class: layer_app
  app_agent: agent.go {
    class: module_box
    AG_Run: {
      class: func_node
      label: |md
        **Run()**
        ---
        * **Args:** ctx
        * **Returns:** error
        * **Desc:** Collector 초기화 및 라이프사이클 관리
      |
    }
  }
}

# ==========================================
# 3. Domain Layer
# ==========================================
DOMAIN_Layer: 3. Core Domain Layer {
  class: layer_domain
  domain_collector: collector/ {
    class: module_box
    collect_worker: worker.go {
      class: module_box
      grid-columns: 2
      dc_Start: {
        class: func_node
        label: |md
          **Start()**
          ---
          * **Args:** ctx
          * **Returns:** error
          * **Desc:** 주기적 데이터 수집 및 계산 루프 시작
        |
      }
      CollectOnce: {
        class: func_node
        label: |md
          **CollectOnce()**
          ---
          * **Args:** (없음)
          * **Returns:** error
          * **Desc:** 단일 수집-계산 사이클 실행
        |
      }
      computeDeltas: {
        class: func_node
        label: |md
          **computeDeltas()**
          ---
          * **Args:** snapshots []WorkloadSnapshot
          * **Returns:** []DeltaMetrics
          * **Desc:** 수집된 스냅샷에서 델타 지표 계산
        |
      }
    }
  }
}

# ==========================================
# 4. Infra Layer
# ==========================================
INFRA_Layer: 4. Infrastructure Layer {
  class: layer_infra
  grid-columns: 2
  infra_postgres: postgres/ {
    class: module_box
    postgres_adapter: adapter.go {
      class: module_box
      FetchCurrentWorkloadSnapshot: {
        class: func_node
        label: |md
          **FetchCurrentWorkloadSnapshot()**
          ---
          * **Args:** 실행 컨텍스트
          * **Returns:** 쿼리 통계 데이터 슬라이스
          * **Desc:** pg_stat_statements 뷰를 조회하여 누적 쿼리 통계 수집
        |
      }
    }
  }
  infra_sqlite: sqlite/ {
    class: module_box
    sqlite_repository: repository.go {
      class: module_box
      grid-columns: 2
      RecordDeltaSnapshots: {
        class: func_node
        label: |md
          **RecordDeltaSnapshots()**
          ---
          * **Args:** 델타 데이터 슬라이스
          * **Returns:** 에러
          * **Desc:** 계산된 델타 지표를 SQLite에 영속화
        |
      }
      SynchronizeOriginalSnapshots: {
        class: func_node
        label: |md
          **SynchronizeOriginalSnapshots()**
          ---
          * **Args:** 최신 누적 목록
          * **Returns:** 에러
          * **Desc:** 누적 통계를 원본 보관함에 업데이트
        |
      }
    }
  }
}

# ==========================================
# 5. Shared Layer
# ==========================================
SHARED_Layer: 5. Shared Layer {
  class: layer_shared
  models: models.go {
    class: module_box
    WorkloadSnapshot: {
      class: type_node
      label: |md
        **WorkloadSnapshot**
        ---
        * **Fields:** Timestamp, QueryID, Query, Calls, TotalTime...
        * **Desc:** 특정 시점의 데이터베이스 쿼리 실행 통계를 담는 구조체
      |
    }
  }
}

# --- 계층 수직 정렬 ---
CLI_Layer -> APP_Layer: { style: { stroke: transparent } }
APP_Layer -> DOMAIN_Layer: { style: { stroke: transparent } }
DOMAIN_Layer -> INFRA_Layer: { style: { stroke: transparent } }

# ==========================================
# --- 에이전트 서비스 호출 로직 (Agent Flow) ---
# ==========================================
CLI_Layer.cmd_agent.CG_Run -> APP_Layer.app_agent.AG_Run: "에이전트 서비스 가동"
APP_Layer.app_agent.AG_Run -> DOMAIN_Layer.domain_collector.collect_worker.dc_Start: "수집기 백그라운드 실행"
DOMAIN_Layer.domain_collector.collect_worker.dc_Start -> DOMAIN_Layer.domain_collector.collect_worker.CollectOnce: "정기 수집 Ticker"

DOMAIN_Layer.domain_collector.collect_worker.CollectOnce -> INFRA_Layer.infra_postgres.postgres_adapter.FetchCurrentWorkloadSnapshot: "PG 누적 통계 추출"
DOMAIN_Layer.domain_collector.collect_worker.CollectOnce -> DOMAIN_Layer.domain_collector.collect_worker.computeDeltas: "TPS/부하량 계산"
DOMAIN_Layer.domain_collector.collect_worker.CollectOnce -> INFRA_Layer.infra_sqlite.sqlite_repository.RecordDeltaSnapshots: "SQLite 시계열 저장"
