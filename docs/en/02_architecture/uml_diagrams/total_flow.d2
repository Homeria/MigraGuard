direction: down

# ==========================================
# 0. 공통 스타일 정의 (Classes)
# ==========================================
classes: {
  layer_cli: {
    style: { fill: "#f9f5ff"; stroke: "#7c3aed"; stroke-width: 2; border-radius: 8 }
  }
  layer_app: {
    style: { fill: "#f0f9ff"; stroke: "#0284c7"; stroke-width: 2; border-radius: 8 }
  }
  layer_domain: {
    style: { fill: "#f0fdf4"; stroke: "#16a34a"; stroke-width: 2; border-radius: 8 }
  }
  layer_infra: {
    style: { fill: "#fffbeb"; stroke: "#d97706"; stroke-width: 2; border-radius: 8 }
  }
  layer_shared: {
    style: { fill: "#f8fafc"; stroke: "#64748b"; stroke-width: 1; border-radius: 8 }
  }
  
  module_box: {
    style: { fill: "#ffffff"; stroke: "#94a3b8"; stroke-width: 1; stroke-dash: 5; border-radius: 4 }
  }
  
  func_node: {
    style: { fill: "#ffffff"; stroke: "#cbd5e1"; stroke-width: 1; border-radius: 6; shadow: true }
  }

  type_node: {
    style: { fill: "#e0e7ff"; stroke: "#4338ca"; stroke-width: 1; border-radius: 6 }
  }
}

# ==========================================
# 1. CLI Layer
# ==========================================
CLI_Layer: 1. CLI & Entry Points Layer (cmd/migraguard) {
  class: layer_cli
  grid-columns: 2

  cmd_agent: agent.go {
    class: module_box
    CG_Run: {
      class: func_node
      label: |md
        **Run()**
        ---
        * **Args:** cmd, args
        * **Returns:** error
        * **Desc:** OS 신호 감지 및 에이전트 서비스 백그라운드 가동
      |
    }
  }

  cmd_analyze: analyze.go {
    class: module_box
    CA_Run: {
      class: func_node
      label: |md
        **Run()**
        ---
        * **Args:** cmd, args
        * **Returns:** error
        * **Desc:** 분석 서비스 기동 및 게이트키핑 종료 코드 결정
      |
    }
  }
}

# ==========================================
# 2. App Layer
# ==========================================
APP_Layer: 2. Application Service Layer (internal/app) {
  class: layer_app
  grid-columns: 2

  app_agent: agent.go {
    class: module_box
    AG_Run: {
      class: func_node
      label: |md
        **Run()**
        ---
        * **Args:** ctx
        * **Returns:** error
        * **Desc:** Collector 초기화 및 라이프사이클 관리
      |
    }
  }

  app_analyze: analyze.go {
    class: module_box
    AA_Run: {
      class: func_node
      label: |md
        **Run()**
        ---
        * **Args:** ctx, task
        * **Returns:** *AnalysisResponse, error
        * **Desc:** 파싱/검증/분석 파이프라인 전체 조율
      |
    }
  }
}

# ==========================================
# 3. Domain Layer
# ==========================================
DOMAIN_Layer: 3. Core Domain Layer (internal/domain) {
  class: layer_domain
  grid-columns: 2

  domain_collector: collector/ {
    class: module_box

    collect_worker: worker.go {
      class: module_box
      grid-columns: 2

      dc_Start: {
        class: func_node
        label: |md
          **Start()**
          ---
          * **Args:** ctx
          * **Returns:** error
          * **Desc:** 주기적 데이터 수집 및 계산 루프 시작
        |
      }

      CollectOnce: {
        class: func_node
        label: |md
          **CollectOnce()**
          ---
          * **Args:** (없음)
          * **Returns:** error
          * **Desc:** 단일 수집-계산 사이클 실행
        |
      }

      computeDeltas: {
        class: func_node
        label: |md
          **computeDeltas()**
          ---
          * **Args:** snapshots []WorkloadSnapshot
          * **Returns:** []DeltaMetrics
          * **Desc:** 수집된 스냅샷에서 델타 지표 계산
        |
      }
    }
  }

  domain_analyzer: analyzer/ {
    class: module_box
    grid-columns: 1

    parser: ast.go {
      class: module_box
      grid-columns: 2

      parseSQL: {
        class: func_node
        label: |md
          **ParseSQL()**
          ---
          * **Args:** sql: string
          * **Returns:** []AnalysisResult, error
          * **Desc:** SQL AST 분석 및 Rewrite 여부 판별
        |
      }

      analyzeAlterTable: {
        class: func_node
        label: |md
          **AnalyzeAlterTable()**
          ---
          * **Args:** stmt: *sqlparser.AlterTable
          * **Returns:** []AnalysisResult, error
          * **Desc:** ALTER TABLE 구문 세부 분석 및 리스크 평가
        |
      }

      normalizeTableName: {
        class: func_node
        label: |md
          **NormalizeTableName()**
          ---
          * **Args:** name: string
          * **Returns:** string
          * **Desc:** 테이블 이름 정규화 (스키마 제거, 소문자 변환)
        |
      }
    }
    
    risk: risk.go {
      class: module_box
      grid-columns: 2

      NewRiskEngine: {
        class: func_node
        label: |md
          **NewRiskEngine()**
          ---
          * **Args:** (없음)
          * **Returns:** *RiskEngine
          * **Desc:** 리스크 엔진 초기화
        |
      }

      AnalyzeRisk: {
        class: func_node
        label: |md
          **AnalyzeRisk()**
          ---
          * **Args:** metrics *TableDynamicMetrics, baseline *BaselineStats
          * **Returns:** *RiskReport
          * **Desc:** 실시간 지표와 과거 통계 기반 리스크 분석 수행
        |
      }
    }

    rule: rule.go {
      class: module_box
      EvaluateRules: {
        class: func_node
        label: |md
          **EvaluateRules()**
          ---
          * **Args:** report *RiskReport
          * **Returns:** []string
          * **Desc:** 리스크 보고서 기반 위험 요소별 대응 방안 도출
        |
      }
    }
  }
}

# ==========================================
# 4. Infra Layer
# ==========================================
INFRA_Layer: 4. Infrastructure & Persistence Layer (internal/infra/) {
  class: layer_infra
  grid-columns: 2

  infra_postgres: postgres/ {
    class: module_box
    grid-columns: 1
    
    postgres_adapter: adapter.go {
      class: module_box
      grid-columns: 2

      NewPostgreAdapter: {
        class: func_node
        label: |md
          **NewPostgreAdapter()**
          ---
          * **Args:** 활성화된 pgxpool 객체
          * **Returns:** PostgreAdapter 인스턴스
          * **Desc:** PostgreAdapter 인스턴스 생성
        |
      }

      FetchCurrentWorkloadSnapshot: {
        class: func_node
        label: |md
          **FetchCurrentWorkloadSnapshot()**
          ---
          * **Args:** 실행 컨텍스트
          * **Returns:** 쿼리 통계 데이터 슬라이스
          * **Desc:** pg_stat_statements 뷰를 조회하여 누적 쿼리 통계 수집
        |
      }

      FetchTableDynamicMetrics: {
        class: func_node
        label: |md
          **FetchTableDynamicMetrics()**
          ---
          * **Args:** 실행 컨텍스트, 대상 테이블명
          * **Returns:** 실시간 지표 객체
          * **Desc:** 대상 테이블의 실시간 상태(크기, 연결 수) 수집
        |
      }

      CheckTableSchemaPresence: {
        class: func_node
        label: |md
          **CheckTableSchemaPresence()**
          ---
          * **Args:** 컨텍스트, 테이블명, 컬럼 목록
          * **Desc:** 테이블 및 컬럼의 실제 존재 여부 사전 검증
        |
      }
    }

    postgres_connection: connection.go {
      class: module_box
      ConnectPostgres: {
        class: func_node
        label: |md
          **ConnectPostgres()**
          ---
          * **Args:** 컨텍스트, URL
          * **Returns:** 활성화된 커넥션 풀 객체
          * **Desc:** PostgresSQL 커넥션 풀 생성
        |
      }
    }
  }

  infra_sqlite: sqlite/ {
    class: module_box
    grid-columns: 3

    sqlite_repository: repository.go {
      class: module_box
      grid-columns: 2

      RecordDeltaSnapshots: {
        class: func_node
        label: |md
          **RecordDeltaSnapshots()**
          ---
          * **Args:** 델타 데이터 슬라이스
          * **Returns:** 에러
          * **Desc:** 계산된 델타 지표를 SQLite에 영속화
        |
      }

      RecordTableDynamicMetrics: {
        class: func_node
        label: |md
          **RecordTableDynamicMetrics()**
          ---
          * **Args:** 동적 지표 객체
          * **Returns:** 에러
          * **Desc:** 특정 시점의 테이블 상태 지표를 영속화
        |
      }

      FetchLastOriginalSnapshot: {
        class: func_node
        label: |md
          **FetchLastOriginalSnapshot()**
          ---
          * **Args:** 없음
          * **Returns:** 마지막 누적 원본 데이터
          * **Desc:** 델타 계산의 기준이 될 마지막 누적 데이터 조회
        |
      }

      SynchronizeOriginalSnapshots: {
        class: func_node
        label: |md
          **SynchronizeOriginalSnapshots()**
          ---
          * **Args:** 최신 누적 목록
          * **Returns:** 에러
          * **Desc:** 누적 통계를 원본 보관함에 업데이트
        |
      }
    }

    sqlite_adapter: adapter.go {
      class: module_box
      grid-columns: 2

      NewSQLiteAdapter: {
        class: func_node
        label: |md
          **NewSQLiteAdapter()**
          ---
          * **Args:** DB 파일 경로
          * **Returns:** SQLiteAdapter 인스턴스
          * **Desc:** SQLite 연결 및 초기 스키마 생성
        |
      }

      InitializeSchema: {
        class: func_node
        label: |md
          **InitializeSchema()**
          ---
          * **Args:** 없음
          * **Returns:** 에러
          * **Desc:** 시계열 및 통계 테이블 정의
        |
      }

      sqlite_close(): {
        class: func_node
        label: |md
          **Close()**
          ---
          * **Args:** 없음
          * **Returns:** 에러
          * **Desc:** SQLite 연결 종료
        |
      }

      MaintenancePurgeData: {
        class: func_node
        label: |md
          **MaintenancePurgeData()**
          ---
          * **Args:** 보존 일수
          * **Returns:** 에러
          * **Desc:** 보존 기간이 지난 노후 데이터 영구 삭제
        |
      }
    }

    sqlite_analyzer: sqlite_analyzer.go {
      class: module_box
      grid-columns: 2

      GetRecentTPSByDelta: {
        class: func_node
        label: |md
          **GetRecentTPSByDelta()**
          ---
          * **Args:** 대상 테이블명
          * **Returns:** 실질 TPS 값
          * **Desc:** 최근 델타 스냅샷을 통한 실시간 TPS 산출
        |
      }

      IdentifySfaeDeploymentWindow: {
        class: func_node
        label: |md
          **IdentifySfaeDeploymentWindow()**
          ---
          * **Args:** 없음
          * **Returns:** 추천 시간대 및 예상 TPS
          * **Desc:** 가장 배포하기 안전한 최적 시간대 추천
        |
      }

      GetLatestTableMetrics: {
        class: func_node
        label: |md
          **GetLatestTableMetrics()**
          ---
          * **Args:** 대상 테이블명
          * **Returns:** 최신 동적 지표
          * **Desc:** 테이블의 마지막 수집 지표 조회
        |
      }

      GetTableBaselineStatistics: {
        class: func_node
        label: |md
          **GetTableBaselineStatistics()**
          ---
          * **Args:** 대상 테이블명
          * **Returns:** 과거 평균 및 피크 통계
          * **Desc:** 과거 24시간 이력 기반 부하 지표 분석
        |
      }

      GetTopHeavyQueries: {
        class: func_node
        label: |md
          **GetTopHeavyQueries()**
          ---
          * **Args:** 추출 개수
          * **Returns:** 상위 부하 쿼리 목록
          * **Desc:** 시스템 리소스 점유 상위 쿼리 추출
        |
      }
    }
  }
}

# ==========================================
# 5. Shared Layer (별도 독립 배치)
# ==========================================
SHARED_Layer: 5. Shared Foundation Layer (internal/shared/) {
  class: layer_shared
  grid-columns: 1

  shared_types: types/ {
    class: module_box
    grid-columns: 2

    models: models.go {
      class: module_box
      grid-columns: 2
      
      WorkloadSnapshot: {
        class: type_node
        label: |md
          **WorkloadSnapshot**
          ---
          * **Fields:** Timestamp, QueryID, Query, Calls, TotalTime, Rows...
          * **Desc:** 쿼리 실행 통계 구조체
        |
      }

      TableDynamicMetrics: {
        class: type_node
        label: |md
          **TableDynamicMetrics**
          ---
          * **Fields:** TableName, TableSize, ActiveConnections, TPS...
          * **Desc:** 테이블별 동적 지표
        |
      }

      BaselineStats: {
        class: type_node
        label: |md
          **BaselineStats**
          ---
          * **Fields:** AvgTPS_1h, PeakTPS_24h
          * **Desc:** 과거 트래픽 통계 정보
        |
      }

      TopQueryInfo: {
        class: type_node
        label: |md
          **TopQueryInfo**
          ---
          * **Fields:** QueryID, QueryText, Impact
          * **Desc:** 상위 부하 쿼리 요약 정보
        |
      }
    }
  }
}

# ==========================================
# --- 계층 강제 수직 정렬 (Force Vertical Stack) ---
# ==========================================
CLI_Layer -> APP_Layer: { style: { stroke: transparent; fill: transparent } }
APP_Layer -> DOMAIN_Layer: { style: { stroke: transparent; fill: transparent } }
DOMAIN_Layer -> INFRA_Layer: { style: { stroke: transparent; fill: transparent } }

# ==========================================
# --- 핵심 서비스 호출 로직 (Core Service Flow) ---
# ==========================================

# [분석 파이프라인]
CLI_Layer.cmd_analyze.CA_Run -> APP_Layer.app_analyze.AA_Run: "분석 오케스트레이션"
APP_Layer.app_analyze.AA_Run -> DOMAIN_Layer.domain_analyzer.parser.parseSQL: "1. 구문 분석(AST)"
APP_Layer.app_analyze.AA_Run -> INFRA_Layer.infra_postgres.postgres_adapter.CheckTableSchemaPresence: "2. 운영 DB 실재 확인"
APP_Layer.app_analyze.AA_Run -> DOMAIN_Layer.domain_analyzer.risk.AnalyzeRisk: "3. 5단계 리스크 모델 실행"

# [리스크 엔진 데이터 참조]
DOMAIN_Layer.domain_analyzer.risk.AnalyzeRisk -> INFRA_Layer.infra_postgres.postgres_adapter.FetchTableDynamicMetrics: "실시간 부하(Size, Conn)"
DOMAIN_Layer.domain_analyzer.risk.AnalyzeRisk -> INFRA_Layer.infra_sqlite.sqlite_analyzer.GetRecentTPSByDelta: "최근 TPS 추이"
DOMAIN_Layer.domain_analyzer.risk.AnalyzeRisk -> INFRA_Layer.infra_sqlite.sqlite_analyzer.GetTableBaselineStatistics: "과거 피크 트래픽 분석"

# [에이전트 수집 루프]
CLI_Layer.cmd_agent.CG_Run -> APP_Layer.app_agent.AG_Run: "에이전트 서비스 가동"
APP_Layer.app_agent.AG_Run -> DOMAIN_Layer.domain_collector.collect_worker.dc_Start: "수집기 백그라운드 실행"
DOMAIN_Layer.domain_collector.collect_worker.dc_Start -> DOMAIN_Layer.domain_collector.collect_worker.CollectOnce: "정기 수집 Ticker"

# [데이터 가공 및 영속화]
DOMAIN_Layer.domain_collector.collect_worker.CollectOnce -> INFRA_Layer.infra_postgres.postgres_adapter.FetchCurrentWorkloadSnapshot: "PG 누적 통계 추출"
DOMAIN_Layer.domain_collector.collect_worker.CollectOnce -> DOMAIN_Layer.domain_collector.collect_worker.computeDeltas: "TPS/부하량 계산"
DOMAIN_Layer.domain_collector.collect_worker.CollectOnce -> INFRA_Layer.infra_sqlite.sqlite_repository.RecordDeltaSnapshots: "SQLite 시계열 저장"

# [시스템 설정]
CLI_Layer.cmd_analyze.CA_Run -> INFRA_Layer.infra_postgres.postgres_connection.ConnectPostgres: "PG 연결"
CLI_Layer.cmd_analyze.CA_Run -> INFRA_Layer.infra_sqlite.sqlite_adapter.NewSQLiteAdapter: "SQLite 초기화"
