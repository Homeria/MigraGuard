direction: down

# ==========================================
# 0. 공통 스타일 정의
# ==========================================
classes: {
  layer_cli: { style: { fill: "#f9f5ff"; stroke: "#7c3aed"; stroke-width: 2; border-radius: 8 } }
  layer_app: { style: { fill: "#f0f9ff"; stroke: "#0284c7"; stroke-width: 2; border-radius: 8 } }
  layer_domain: { style: { fill: "#f0fdf4"; stroke: "#16a34a"; stroke-width: 2; border-radius: 8 } }
  layer_infra: { style: { fill: "#fffbeb"; stroke: "#d97706"; stroke-width: 2; border-radius: 8 } }
  layer_shared: { style: { fill: "#f8fafc"; stroke: "#64748b"; stroke-width: 1; border-radius: 8 } }
  module_box: { style: { fill: "#ffffff"; stroke: "#94a3b8"; stroke-width: 1; stroke-dash: 5; border-radius: 4 } }
  func_node: { style: { fill: "#ffffff"; stroke: "#cbd5e1"; stroke-width: 1; border-radius: 6; shadow: true } }
  type_node: { style: { fill: "#e0e7ff"; stroke: "#4338ca"; stroke-width: 1; border-radius: 6 } }
}

# ==========================================
# 1. CLI Layer
# ==========================================
CLI_Layer: 1. CLI Layer {
  class: layer_cli
  cmd_analyze: analyze.go {
    class: module_box
    CA_Run: {
      class: func_node
      label: |md
        **Run()**
        ---
        * **Args:** cmd, args
        * **Returns:** error
        * **Desc:** 분석 서비스 기동 및 게이트키핑 종료 코드 결정
      |
    }
  }
}

# ==========================================
# 2. App Layer
# ==========================================
APP_Layer: 2. Application Service Layer {
  class: layer_app
  app_analyze: analyze.go {
    class: module_box
    AA_Run: {
      class: func_node
      label: |md
        **Run()**
        ---
        * **Args:** ctx, task
        * **Returns:** *AnalysisResponse, error
        * **Desc:** 파싱/검증/분석 파이프라인 전체 조율
      |
    }
  }
}

# ==========================================
# 3. Domain Layer
# ==========================================
DOMAIN_Layer: 3. Core Domain Layer {
  class: layer_domain
  domain_analyzer: analyzer/ {
    class: module_box
    parser: ast.go {
      class: module_box
      grid-columns: 2
      parseSQL: {
        class: func_node
        label: |md
          **ParseSQL()**
          ---
          * **Args:** sql: string
          * **Returns:** []AnalysisResult, error
          * **Desc:** SQL AST 분석 및 Rewrite 여부 판별
        |
      }
      analyzeAlterTable: {
        class: func_node
        label: |md
          **AnalyzeAlterTable()**
          ---
          * **Args:** stmt: *sqlparser.AlterTable
          * **Returns:** []AnalysisResult, error
          * **Desc:** ALTER TABLE 구문 세부 분석 및 리스크 평가
        |
      }
    }
    risk: risk.go {
      class: module_box
      grid-columns: 2
      NewRiskEngine: {
        class: func_node
        label: |md
          **NewRiskEngine()**
          ---
          * **Args:** (없음)
          * **Returns:** *RiskEngine
          * **Desc:** 리스크 엔진 초기화
        |
      }
      AnalyzeRisk: {
        class: func_node
        label: |md
          **AnalyzeRisk()**
          ---
          * **Args:** metrics *TableDynamicMetrics, baseline *BaselineStats
          * **Returns:** *RiskReport
          * **Desc:** 실시간 지표와 과거 통계 기반 리스크 분석 수행
        |
      }
    }
  }
}

# ==========================================
# 4. Infra Layer
# ==========================================
INFRA_Layer: 4. Infrastructure Layer {
  class: layer_infra
  grid-columns: 2
  infra_postgres: postgres/ {
    class: module_box
    postgres_adapter: adapter.go {
      class: module_box
      grid-columns: 2
      FetchTableDynamicMetrics: {
        class: func_node
        label: |md
          **FetchTableDynamicMetrics()**
          ---
          * **Args:** 실행 컨텍스트, 대상 테이블명
          * **Returns:** 실시간 지표 객체
          * **Desc:** 대상 테이블의 실시간 상태(크기, 연결 수) 수집
        |
      }
      CheckTableSchemaPresence: {
        class: func_node
        label: |md
          **CheckTableSchemaPresence()**
          ---
          * **Args:** 컨텍스트, 테이블명, 컬럼 목록
          * **Desc:** 테이블 및 컬럼의 실제 존재 여부 사전 검증
        |
      }
    }
  }
  infra_sqlite: sqlite/ {
    class: module_box
    sqlite_analyzer: sqlite_analyzer.go {
      class: module_box
      grid-columns: 2
      GetRecentTPSByDelta: {
        class: func_node
        label: |md
          **GetRecentTPSByDelta()**
          ---
          * **Desc:** 최근 TPS 도출
        |
      }
      GetTableBaselineStatistics: {
        class: func_node
        label: |md
          **GetTableBaselineStatistics()**
          ---
          * **Desc:** 과거 평균 및 피크 데이터 분석
        |
      }
    }
  }
}

# ==========================================
# 5. Shared Layer
# ==========================================
SHARED_Layer: 5. Shared Layer {
  class: layer_shared
  models: models.go {
    class: module_box
    grid-columns: 2
    TableDynamicMetrics: {
      class: type_node
      label: |md
        **TableDynamicMetrics**
        ---
        * **Fields:** TableName, TableSize, ActiveConnections, TPS...
        * **Desc:** 테이블별 동적 지표
      |
    }
    BaselineStats: {
      class: type_node
      label: |md
        **BaselineStats**
        ---
        * **Fields:** AvgTPS_1h, PeakTPS_24h
        * **Desc:** 과거 트래픽 통계 정보
      |
    }
  }
}

# --- 계층 수직 정렬 ---
CLI_Layer -> APP_Layer: { style: { stroke: transparent } }
APP_Layer -> DOMAIN_Layer: { style: { stroke: transparent } }
DOMAIN_Layer -> INFRA_Layer: { style: { stroke: transparent } }

# ==========================================
# --- 분석 서비스 호출 로직 (Analyze Flow) ---
# ==========================================
CLI_Layer.cmd_analyze.CA_Run -> APP_Layer.app_analyze.AA_Run: "분석 오케스트레이션"
APP_Layer.app_analyze.AA_Run -> DOMAIN_Layer.domain_analyzer.parser.parseSQL: "1. 구문 분석(AST)"
APP_Layer.app_analyze.AA_Run -> INFRA_Layer.infra_postgres.postgres_adapter.CheckTableSchemaPresence: "2. 운영 DB 실재 확인"
APP_Layer.app_analyze.AA_Run -> DOMAIN_Layer.domain_analyzer.risk.AnalyzeRisk: "3. 5단계 리스크 모델 실행"

DOMAIN_Layer.domain_analyzer.risk.AnalyzeRisk -> INFRA_Layer.infra_postgres.postgres_adapter.FetchTableDynamicMetrics: "실시간 부하(Size, Conn)"
DOMAIN_Layer.domain_analyzer.risk.AnalyzeRisk -> INFRA_Layer.infra_sqlite.sqlite_analyzer.GetRecentTPSByDelta: "최근 TPS 추이"
DOMAIN_Layer.domain_analyzer.risk.AnalyzeRisk -> INFRA_Layer.infra_sqlite.sqlite_analyzer.GetTableBaselineStatistics: "과거 피크 트래픽 분석"
